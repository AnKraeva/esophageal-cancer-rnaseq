// параметры пайплайна: значения по умолчанию, можно переопределить через --имя в команде
params {
    reads  = "data/raw/*_{1,2}.sub1M.fastq.gz"   // шаблон для поиска пар ридов
    outdir = "results"                            // куда складывать итоговые результаты
}

// общие лимиты для всего пайплайна
executor {
    cpus   = 8         // всем задачам вместе — не больше 8 ядер из 10
    memory = '16 GB'   // и не больше 16 ГБ памяти
}

// профили: готовые наборы настроек, выбираются через -profile
profiles {
    docker {
        docker.enabled    = true
        // запускать контейнер от имени твоего пользователя, а не root
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
}


// куда складывать результаты, по имени вызова
process {
    withName: 'FASTQC_RAW' {
        ext.prefix = { "${sample}_raw" }   // фигурные скобки: значение считается для каждого образца
        publishDir = [path: "${params.outdir}/qc/fastqc_raw", mode: 'copy']
    }
    withName: 'FASTP' {
        // только отчёты; обрезанные fastq остаются в work/, чтобы не копировать гигабайты
        publishDir = [path: "${params.outdir}/qc/fastp", mode: 'copy', pattern: '*.{json,html}']
    }
    withName: 'FASTQC_TRIM' {
        ext.prefix = { "${sample}_trim" }
        publishDir = [path: "${params.outdir}/qc/fastqc_trim", mode: 'copy']
    }
    withName: 'MULTIQC' {
        publishDir = [path: "${params.outdir}/qc/multiqc", mode: 'copy']
    }
}